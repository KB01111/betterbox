# Copy to .dev.vars for Vite/workerd local development. Never commit that file.
# Production values go into Cloudflare Secrets, not VITE_* variables.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-web-client-secret
# Required: exact addresses, or *@gmail.com to admit any verified Gmail identity.
ALLOWED_EMAILS=you@example.com,another-account@example.com
IS_SELF_HOSTED=true
# Optional: exact image hosts trusted by the administrator. Empty blocks proxying.
IMAGE_PROXY_HOSTS=
# Optional integration; configure both or neither. Gmail does not require these.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# DB is a Cloudflare D1 binding in wrangler.jsonc, never a database URL.
